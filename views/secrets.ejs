<%- include('partials/header') %>

<div class="jumbotron text-center">
    <div class="container">
      <i class="fas fa-key fa-6x"></i>
      <h1 class="display-3">My Secret</h1>
      <p class="lead">You are <strong><%= displayName %></strong> — here's your secret:</p>

      <% if (message.length > 0) { %>
        <div class="alert alert-success" role="alert"><%= message %></div>
      <% } %>

      <p class="secret-text">
        <%= secret %>
      </p>
      <hr>

      <a class="btn btn-light btn-lg" href="/logout" role="button">Log Out</a>

      <% if (hasSecret) { %>
        <a class="btn btn-dark btn-lg" href="/submit" role="button">Update My Secret</a>
        <form action="/submit/delete" method="POST" class="d-inline"
              onsubmit="return confirm('Delete your secret? This cannot be undone.');">
          <button type="submit" class="btn btn-danger btn-lg">Delete My Secret</button>
        </form>
      <% } else { %>
        <a class="btn btn-dark btn-lg" href="/submit" role="button">Submit a Secret</a>
      <% } %>
    </div>
  </div>
  </div>

  <div class="container mt-5 mb-5">
    <h2 class="text-center mb-1">Community Secrets</h2>
    <p class="text-center text-muted mb-4">Secrets shared by other users, anonymously.</p>

    <% if (communitySecrets.length === 0) { %>
      <p class="text-center">No secrets shared yet. Be the first!</p>
    <% } else { %>
      <div class="row">
        <% communitySecrets.forEach(function (row) { %>
          <div class="col-md-6 mb-3">
            <div class="card h-100">
              <div class="card-body">
                <p class="card-text secret-text"><%= row.secret %></p>
                <p class="card-text mt-2">
                  <small class="text-muted">
                    <i class="fas fa-user-secret"></i>
                    From <%= row.display_name %> · <%= row.time %>
                  </small>
                </p>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>