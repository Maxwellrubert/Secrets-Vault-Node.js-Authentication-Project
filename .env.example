# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Local dev callback URL. On deployment, set this to your public URL, e.g.
# https://your-app.onrender.com/auth/google/secrets
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/secrets

# Used by express-session to sign cookies. Use a long random string.
SESSION_SECRET=some_long_random_secret

# Local PostgreSQL (used when DATABASE_URL is not set)
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=world-db
PG_PASSWORD=your_pg_password
PG_PORT=5432

# Deployment databases (e.g. Neon/Render) supply a single connection string.
# The app prefers DATABASE_URL over the PG_* vars when both are present.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require